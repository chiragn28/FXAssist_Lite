# Copy to .env and edit: `cp .env.example .env`. .env is git-ignored.
# Every FXA_* variable used in deploy/compose/compose.yaml must be listed here
# (enforced by tests/test_compose.py).

# --- Host ports (ENV-04). Change any of these if the port is already taken. ---
# Bind address for published ports. 127.0.0.1 keeps services off your LAN (OBS-04).
FXA_BIND_ADDR=127.0.0.1
FXA_QDRANT_HTTP_PORT=6333
FXA_QDRANT_GRPC_PORT=6334
FXA_REDIS_PORT=6379
FXA_POSTGRES_PORT=5432

# --- PostgreSQL (local development only) ---
FXA_POSTGRES_USER=fxassist
FXA_POSTGRES_DB=fxassist
# Placeholder for local use. Never reuse a real password here.
FXA_POSTGRES_PASSWORD=local-dev-only-change-me
