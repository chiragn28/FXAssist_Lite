# Copy to .env and edit: `cp .env.example .env`. .env is git-ignored.
# Every FXA_* variable used in deploy/compose/compose.yaml must be listed here
# (enforced by tests/test_compose.py).

# --- Host ports (ENV-04). Change any of these if the port is already taken. ---
# Bind address for published ports. 127.0.0.1 keeps services off your LAN (OBS-04).
FXA_BIND_ADDR=127.0.0.1
FXA_QDRANT_HTTP_PORT=6333
FXA_QDRANT_GRPC_PORT=6334
FXA_REDIS_PORT=6379
FXA_POSTGRES_PORT=5432
FXA_GATEWAY_PORT=8000
FXA_MOCK_LLM_PORT=8081
FXA_PROMETHEUS_PORT=9090
FXA_GRAFANA_PORT=3000

# --- PostgreSQL (local development only) ---
FXA_POSTGRES_USER=fxassist
FXA_POSTGRES_DB=fxassist
# Placeholder for local use. Never reuse a real password here.
FXA_POSTGRES_PASSWORD=local-dev-only-change-me

# --- Local LLM (ADR-003, ADR-022). Any OpenAI-compatible server works here. ---
FXA_OLLAMA_PORT=11434
FXA_LLM_BASE_URL=http://localhost:11434/v1
FXA_LLM_MODEL=qwen2.5:3b-instruct

# --- Gateway in compose (Phase 2). `make up` points it at Ollama, `make up-lite` at the mock. ---
FXA_GATEWAY_LLM_BASE_URL=http://mock-llm:8080/v1
FXA_GATEWAY_LLM_MODEL=mock-llm
# Benchmarks refuse to run while this is true (CAC-05).
FXA_CACHE_ENABLED=true

# --- Observability (Phase 3) ---
# Grafana admin login (dashboards are also viewable without logging in, on localhost only).
FXA_GRAFANA_ADMIN_PASSWORD=local-dev-only-change-me
# Optional: send traces to Langfuse Cloud (free Hobby tier, no card). Leave empty to disable.
FXA_LANGFUSE_PUBLIC_KEY=
FXA_LANGFUSE_SECRET_KEY=
FXA_LANGFUSE_HOST=https://cloud.langfuse.com
# Put (truncated, redacted) questions and answers on trace spans. Off by default (OBS-02).
FXA_TRACE_CONTENT=false
